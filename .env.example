# White-label tenant (optional)
# Sector: default | finance | healthcare | saas | government
VITE_TENANT_SECTOR=default
VITE_TENANT_BRAND_NAME=MFCA
VITE_TENANT_PRODUCT_NAME=Multi Factor Cloud Authentication
